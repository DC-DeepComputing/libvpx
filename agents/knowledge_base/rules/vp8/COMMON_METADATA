agentic_review {
  capability_groups {
    path_expression: "vp8/(?:.*/)?[^/]*\\.(?:c|cc|cpp|h)"
    path_expression: "vp8/encoder/.*"
    path_expression: "vp9/(?:.*/)?[^/]*\\.(?:c|cc|cpp|h)"
    path_expression: "vp9/encoder/.*"
    rules: "agents/knowledge_base/rules/vp8/apply-rate-control-overflow-fixes-to-counterpart-routines.md"
  }
  capability_groups {
    path_expression: "vp8/encoder/.*"
    path_expression: "vp9/encoder/.*"
    path_expression: "vpx_dsp/.*"
    rules: "agents/knowledge_base/rules/vp8/compute-eob-in-simd-registers.md"
  }
  capability_groups {
    path_expression: "vp8/.*"
    path_expression: "vp9/.*"
    rules: "agents/knowledge_base/rules/vp8/symmetric-cpu-used-range-check.md"
    rules: "agents/knowledge_base/rules/vp8/synchronize-worker-threads-before-buffer-consumers.md"
  }
  capability_groups {
    path_expression: "(?:.*/)?[^/]*_cx_iface\\.c"
    path_expression: "vp8/vp8_cx_iface\\.c"
    path_expression: "vp9/vp9_cx_iface\\.c"
    rules: "agents/knowledge_base/rules/vp8/use-local-flags-variable-in-encoder-encode.md"
  }
}
