  capability_groups {
    path_expression: "vp9/(?:.*/)?[^/]*\\.(?:cc|cpp|h|hpp|mm)"
    rules: "knowledge_base/rules/vp9/guard-external-buffer-release-callbacks.md"
  }
  capability_groups {
    path_expression: "vp9/encoder/(?:.*/)?[^/]*\\.(?:cc|cpp|h|hpp|mm)"
    path_expression: "vp9/vp9_cx_iface\\.c"
    rules: "knowledge_base/rules/vp9/guard-svc-state-with-use-svc.md"
  }
  capability_groups {
    path_expression: "vp8/encoder/.*"
    path_expression: "vp9/encoder/.*"
    rules: "knowledge_base/rules/vp9/place-rate-control-logic-in-ratectrl-module.md"
  }
  capability_groups {
    path_expression: "vp9/(?:.*/)?[^/]*\\.(?:c|cc|cpp|h)"
    path_expression: "vp9/encoder/.*"
    rules: "knowledge_base/rules/vp9/sync-mirrored-rate-control-heuristics.md"
  }
  capability_groups {
    path_expression: "vp9/encoder/(?:.*/)?[^/]*\\.(?:c|cc|cpp|h)"
    rules: "knowledge_base/rules/vp9/sync-svc-reference-flags-and-buffer-indices.md"
  }
