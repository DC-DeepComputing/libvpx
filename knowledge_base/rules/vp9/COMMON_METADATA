agentic_review {
  capability_groups {
    path_expression: "vp9/encoder/.*"
    rules: "knowledge_base/rules/vp9/configure-speed-heuristics-in-speed-features.md"
    rules: "knowledge_base/rules/vp9/differentiate-layer-depth-for-gf-vs-overlay-update.md"
    rules: "knowledge_base/rules/vp9/support-updating-arbitrary-svc-reference-buffer-slots.md"
