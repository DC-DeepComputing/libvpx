agentic_review {
  capability_groups {
    path_expression: "vpx/.*"
    rules: "knowledge_base/rules/vpx/append-public-api-enum-entries-for-abi-compatibility.md"
    rules: "knowledge_base/rules/vpx/document-codec-control-values-and-defaults.md"
  }
  capability_groups {
    path_expression: "vpx/(?:.*/)?[^/]*\\.h"
    rules: "knowledge_base/rules/vpx/bump-abi-version-on-public-header-changes.md"
    rules: "knowledge_base/rules/vpx/document-public-api-and-callbacks-with-doxygen.md"
  }
  capability_groups {
    path_expression: "vpx/(?:.*/)?[^/]*\\.(?:cc|cpp|h|hpp|mm)"
    rules: "knowledge_base/rules/vpx/require-caller-allocation-or-library-deallocator.md"
  }
}
